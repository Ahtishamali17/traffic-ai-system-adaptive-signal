# Copy this file to .env and fill in real values.
# NEVER commit the real .env file to git.

# --- General ---
ENVIRONMENT=development
DEBUG=True

# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- MongoDB ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=traffic_monitoring

# --- AI Model ---
MODEL_WEIGHTS_PATH=models/weights/yolov8n.pt
DEVICE=cpu
CONFIDENCE_THRESHOLD=0.4
IOU_THRESHOLD=0.45

# --- Alerts (optional, leave blank to disable) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# --- Speed / Violations ---
SPEED_LIMIT_KMPH=60
PIXELS_PER_METER=8.0

# --- Security ---
SECRET_KEY=change_this_to_a_random_secret_in_production
